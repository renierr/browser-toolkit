{
  "name": "browser-toolkit",
  "description": "Collection of Tools in Browser only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist node_modules/.vite",
    "prebuild": "pnpm run clean",
    "build": "vite build",
    "tsc": "tsc --noEmit",
    "preview": "vite preview --port 5000",
    "build:preview": "pnpm run build && pnpm run preview",
    "format": "prettier --write \"src/**/*.{js,ts,html,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,html,css,json,md}\"",
    "upgrade:check": "pnpm outdated",
    "upgrade:deps": "pnpm up --latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/sortablejs": "^1.15.9",
    "@types/web-bluetooth": "0.0.21",
    "daisyui": "^5.5.19",
    "extract-zip": "^2.0.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "license": "MIT",
  "dependencies": {
    "@embedpdf/models": "^2.10.1",
    "@embedpdf/plugin-annotation": "^2.10.1",
    "@embedpdf/snippet": "^2.10.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide": "^1.7.0",
    "mupdf": "^1.27.0",
    "onnxruntime-web": "^1.24.3",
    "sortablejs": "^1.15.7"
  }
}
