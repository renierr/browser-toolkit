{
  "name": "browser-toolkit",
  "description": "Collection of Tools in Browser only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist node_modules/.vite",
    "prebuild": "bun run clean",
    "build": "vite build",
    "tsc": "tsc --noEmit",
    "preview": "vite preview --port 5000",
    "build:preview": "bun run build && bun run preview",
    "format": "prettier --write \"src/**/*.{js,ts,html,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,html,css,json,md}\"",
    "upgrade:check": "bun outdated",
    "upgrade:deps": "bun update",
    "generate:tool-description": "bun scripts/generate-tool-description.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.2",
    "@types/sortablejs": "^1.15.9",
    "@types/web-bluetooth": "0.0.21",
    "daisyui": "^5.5.19",
    "extract-zip": "^2.0.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@embedpdf/models": "^2.14.2",
    "@embedpdf/plugin-annotation": "^2.14.2",
    "@embedpdf/snippet": "^2.14.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide": "^1.14.0",
    "markdown-it": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mupdf": "^1.27.0",
    "onnxruntime-web": "^1.26.0",
    "overtype": "^2.3.10",
    "sortablejs": "^1.15.7"
  },
  "workspaces": [
    "src/tools/**"
  ]
}
